[Unit]
Description=rgit backup to GitHub
RequiresMountsFor=/opt/usr/local/rgit
After=network-online.target opt.mount

[Service]
Type=oneshot
User=git
WorkingDirectory=/opt/usr/local/rgit
Environment=RGIT_BACKUP_REPO_URL=git@github.com:xiedeacc/rgit_data.git
Environment=RGIT_BACKUP_ROOT=/opt/usr/local/rgit
Environment=RGIT_BACKUP_WORK_DIR=/opt/usr/local/rgit/.backup-worktree
Environment=HOME=/opt/usr/local/rgit
Environment="GIT_SSH_COMMAND=ssh -i /opt/usr/local/rgit/.ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/opt/usr/local/rgit/.ssh/known_hosts"
ExecStart=/opt/usr/local/rgit/bin/rgit-backup
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/usr/local/rgit
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
